# ============================================
# CONFIGURAÇÃO DO SUPABASE
# ============================================
# Copie este arquivo para .env.local e preencha os valores
# do seu projeto (menu Settings > API no painel do Supabase)

# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon pública (segura para navegador, começa com eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-AQUI

# Chave service_role do Supabase. SOMENTE no servidor; nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar JWT de sessão (mínimo 32 caracteres)
SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# ============================================
# ASAAS — cobrança da mensalidade
# ============================================
# Chave de API do Asaas. Somente no servidor.
ASAAS_API_KEY=

# URL da API do Asaas (opcional; padrão produção)
ASAAS_API_URL=https://api.asaas.com/v3

# Token de segurança do webhook Asaas (opcional, recomendado)
ASAAS_WEBHOOK_TOKEN=

# Evolution API — conexão WhatsApp por loja e webhook público
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# URL pública do app (obrigatória para webhooks externos)
APP_URL=https://SEU-DOMINIO

# Gemini usado pelo atendente de WhatsApp (chave somente no servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# URL pública de produção do cardápio (Vercel).
NEXT_PUBLIC_CARDAPIO_URL=https://SEU-DOMINIO-CARDAPIO.vercel.app
