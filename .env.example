# ============================================
# CONFIGURAÇÃO DO SUPABASE
# ============================================
# Copie este arquivo para .env.local e preencha os valores
# do seu projeto (menu Settings > API no painel do Supabase)

# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon pública (segura para navegador, começa com eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-AQUI

# Chave service_role do Supabase. Somente no servidor; nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# ASAAS — cobrança da mensalidade (R$ 49,99/mês)
# ============================================
# Chave de API do Asaas
# Configure esta variável e ASAAS_API_URL nas variáveis de ambiente da Vercel.
# Nunca envie chaves reais neste arquivo.
# Painel Asaas > Integrações > Chave de API
ASAAS_API_KEY=SUA-CHAVE-ASAAS-AQUI

# URL da API do Asaas (opcional; o padrão é a API de produção)
ASAAS_API_URL=https://api.asaas.com/v3

# (Opcional) Token de segurança do webhook. Se preenchido, o Asaas
# precisa enviar o mesmo valor no cabeçalho asaas-access-token.
# Configure a URL do webhook no painel do Asaas: https://SEU-DOMINIO/api/webhook-asaas
ASAAS_WEBHOOK_TOKEN=

# Evolution API — conexão WhatsApp por loja e webhook público
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# URL pública do app (obrigatória para a Evolution enviar webhooks)
APP_URL=https://SEU-DOMINIO

# Gemini usado pelo atendente de WhatsApp (chave somente no servidor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# URL p�blica de produ��o do card�pio (Vercel). Usada para gerar/copiar/compartilhar
# o link do card�pio para clientes. Em .exe/.apk/Electron/Capacitor ou quando o app
# roda em localhost/127.0.0.1, o link p�blico NUNCA usa origem local: usa esta URL.
# Exemplo: https://meu-cardapio.vercel.app (sem barra no final)
NEXT_PUBLIC_CARDAPIO_URL=https://pdvharleysystems-aibjds6ud-pdv-dg.vercel.app
